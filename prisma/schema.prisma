generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshToken       RefreshToken?
  passwordResetToken PasswordResetToken?
  images             Image[]
  likes              Like[]
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  value     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([value])
}

model Image {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  originalName   String
  size           Int
  format         String
  publicId       String
  secureUrl      String
  downloadsCount Int      @default(0)
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transformedImages TransformedImage[]
  likes             Like[]

  @@index([userId, createdAt])
  @@index([userId, id])
}

model TransformedImage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  originalImageId String   @db.ObjectId
  publicId        String
  secureUrl       String
  size            Int
  transformation  Json
  downloadsCount  Int      @default(0)
  parentId        String?  @db.ObjectId
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent                       TransformedImage?  @relation("TransformedImageTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  originalImage                Image              @relation(fields: [originalImageId], references: [id], onDelete: Cascade)
  transformedTransformedImages TransformedImage[] @relation("TransformedImageTree")
  likes                        Like[]

  @@index([parentId])
  @@index([originalImageId])
}

model Like {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  imageId            String?  @db.ObjectId
  transformedImageId String?  @db.ObjectId
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  image            Image?            @relation(fields: [imageId], references: [id], onDelete: Cascade)
  transformedImage TransformedImage? @relation(fields: [transformedImageId], references: [id], onDelete: Cascade)

  @@unique([userId, imageId, transformedImageId])
  @@index([userId, imageId])
  @@index([userId, transformedImageId])
}
